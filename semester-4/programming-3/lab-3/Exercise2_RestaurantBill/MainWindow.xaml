<Window x:Class="Exercise2_RestaurantBill.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Exercise2_RestaurantBill"
        mc:Ignorable="d"
        Title="Restaurant Bill Calculator" Height="500" Width="900">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Restaurant Bill Calculator by: Julian Sellanes"
                   FontSize="24"
                   FontWeight="Bold"
                   Margin="0,0,0,12"/>

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="5">
                <TextBlock Text="Beverage" FontWeight="Bold" Margin="0,0,0,5"/>
                <ComboBox x:Name="cmbBeverage"
                          ItemsSource="{Binding Beverages}"
                          DisplayMemberPath="Name"
                          SelectionChanged="ComboBox_SelectionChanged"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Margin="5">
                <TextBlock Text="Appetizer" FontWeight="Bold" Margin="0,0,0,5"/>
                <ComboBox x:Name="cmbAppetizer"
                          ItemsSource="{Binding Appetizers}"
                          DisplayMemberPath="Name"
                          SelectionChanged="ComboBox_SelectionChanged"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Margin="5">
                <TextBlock Text="Main Course" FontWeight="Bold" Margin="0,0,0,5"/>
                <ComboBox x:Name="cmbMainCourse"
                          ItemsSource="{Binding MainCourses}"
                          DisplayMemberPath="Name"
                          SelectionChanged="ComboBox_SelectionChanged"/>
            </StackPanel>

            <StackPanel Grid.Column="3" Margin="5">
                <TextBlock Text="Dessert" FontWeight="Bold" Margin="0,0,0,5"/>
                <ComboBox x:Name="cmbDessert"
                          ItemsSource="{Binding Desserts}"
                          DisplayMemberPath="Name"
                          SelectionChanged="ComboBox_SelectionChanged"/>
            </StackPanel>
        </Grid>

        <DataGrid x:Name="dgBill"
                  Grid.Row="2"
                  ItemsSource="{Binding BillItems}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  CellEditEnding="dgBill_CellEditEnding"
                  Margin="0,0,0,12">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Item"
                                    Binding="{Binding Name}"
                                    IsReadOnly="True"
                                    Width="2*"/>

                <DataGridTextColumn Header="Category"
                                    Binding="{Binding Category}"
                                    IsReadOnly="True"
                                    Width="2*"/>

                <DataGridTextColumn Header="Price"
                                    Binding="{Binding Price, StringFormat={}{0:C}}"
                                    IsReadOnly="True"
                                    Width="*"/>

                <DataGridTextColumn Header="Quantity"
                                    Binding="{Binding Quantity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    Width="*"/>

                <DataGridTextColumn Header="Line Total"
                                    Binding="{Binding LineTotal, StringFormat={}{0:C}}"
                                    IsReadOnly="True"
                                    Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="240"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="btnRemove"
                        Content="Remove Selected"
                        Width="140"
                        Margin="0,0,10,0"
                        Click="btnRemove_Click"/>

                <Button x:Name="btnClear"
                        Content="Clear Bill"
                        Width="100"
                        Click="btnClear_Click"/>
            </StackPanel>

            <StackPanel Grid.Column="1">
                <DockPanel Margin="0,2">
                    <TextBlock Text="Subtotal:" Width="100" FontWeight="Bold"/>
                    <TextBlock x:Name="txtSubtotal"/>
                </DockPanel>

                <DockPanel Margin="0,2">
                    <TextBlock Text="Tax:" Width="100" FontWeight="Bold"/>
                    <TextBlock x:Name="txtTax"/>
                </DockPanel>

                <DockPanel Margin="0,2">
                    <TextBlock Text="Total:" Width="100" FontWeight="Bold"/>
                    <TextBlock x:Name="txtTotal"/>
                </DockPanel>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
